# Copy this file to .env and fill in what you need.
# Everything below is OPTIONAL -- the app runs with zero configuration,
# using SQLite + an in-memory rate limiter + no-op email/webhooks/monitoring.
# Fill in a section to turn that feature on.

# ---- Database (Postgres) ----------------------------------------
# Leave unset to use local SQLite. Set this to switch to Postgres.
# DATABASE_URL=postgresql://user:password@localhost:5432/aqtify

# ---- Redis (rate limiting) ---------------------------------------
# Leave unset to use an in-memory rate limiter (fine for single-instance).
# REDIS_URL=redis://localhost:6379/0

# ---- Email (SMTP) -- sends the secured file + certificate to owners ----
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=
# SMTP_FROM=noreply@yourdomain.com
# SMTP_USE_TLS=true

# ---- Webhooks ------------------------------------------------------
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_RETRIES=2

# ---- AI-detection gate (registration) -------------------------------
# % AI-probability above which media is flagged for manual review but still registers
AQTIFY_AI_FLAG_THRESHOLD=10
# % AI-probability above which registration is rejected outright
AQTIFY_AI_BLOCK_THRESHOLD=60

# ---- App secret (used for signing/session material) -----------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=

# ---- TLS (only if not terminating TLS at a reverse proxy) -----------
# SSL_KEYFILE=/path/to/privkey.pem
# SSL_CERTFILE=/path/to/fullchain.pem

# ---- Monitoring -------------------------------------------------------
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- Public base URL (used to build badge/embed links) ---------------
PUBLIC_BASE_URL=http://127.0.0.1:8000
