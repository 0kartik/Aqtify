{
  "manifest_version": 3,
  "name": "Aqtify — PQ-SMAP Verifier",
  "version": "1.0.0",
  "description": "Right-click any image to check it against the Aqtify authenticity registry.",
  "permissions": ["contextMenus", "storage", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aqtify PQ-SMAP"
  },
  "icons": {
    "48": "icons/icon48.png"
  }
}
